model Excecao_Disponibilidade {
  ID_Excecao         Int             @id @default(autoincrement())
  ID_Disponibilidade Int
  Data_Cancelada     DateTime        @db.Date
  Disponibilidade    Disponibilidade @relation(fields: [ID_Disponibilidade], references: [ID_Disponibilidade], onDelete: Cascade, onUpdate: NoAction, map: "FK_Excecao_Disponibilidade")

  @@unique([ID_Disponibilidade, Data_Cancelada], map: "UQ_Excecao_Disponibilidade_Data")
}

model Pedido_Coaching_Aluno {
  ID_Pedido       Int
  ID_Aluno        Int
  Aluno           Aluno           @relation(fields: [ID_Aluno], references: [ID_aluno], onDelete: Cascade, onUpdate: NoAction, map: "FK_PedidoCoachingAluno_Aluno")
  Pedido_Coaching Pedido_Coaching @relation(fields: [ID_Pedido], references: [ID_Pedido], onDelete: Cascade, onUpdate: NoAction, map: "FK_PedidoCoachingAluno_Pedido")

  @@id([ID_Pedido, ID_Aluno], map: "PK_Pedido_Coaching_Aluno")
}

model Professor_Modalidade {
  ID_Professor  Int
  ID_Modalidade Int
  Modalidade    Modalidade @relation(fields: [ID_Modalidade], references: [ID_Modalidade], onDelete: Cascade, onUpdate: NoAction, map: "FK_ProfessorModalidade_Modalidade")
  Professor     Professor  @relation(fields: [ID_Professor], references: [ID_Pessoa], onDelete: Cascade, onUpdate: NoAction, map: "FK_ProfessorModalidade_Professor")

  @@id([ID_Professor, ID_Modalidade], map: "PK_Professor_Modalidade")
}
